			<Events>
				<Event>
					<Id>1792489962930</Id>
					<Name><![CDATA[telemetryEvent]]></Name>
					<X>420</X><Y>860</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1792489962928</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1792569600000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[if (mqttClient != null && mqttClient.isConnected()) {
    // 1. Gather Critical Buffer & Staging Metrics
    int qAccumulation = accumulationBuffer.size();
    int qStaging = stagingBufferDelay.size();
    int qDownstream = queueDownstream.size();
    int qInspection = delayInspection.size();
    int qPackaging = queuePackaging.size();
    int qPalletizer = queuePalletizer.size();

    // 2. Extract True Simulation Clock (Model Time in Hours) and Sink Count
    double modelHours = time() / 3600.0;
    long totalSinkCount = sinkDispatch.count();

    // 3. Compute Instantaneous Energy Consumption (kW) with AGV Fleet Factor
    currentPowerKW = 7.2; // Base facility load
    currentPowerKW += (delayOven_1.size() > 0) ? 1.8 : 0.0;
    currentPowerKW += (delayOven_2.size() > 0) ? 1.8 : 0.0;
    currentPowerKW += (delayOven_3.size() > 0) ? 1.8 : 0.0;
    currentPowerKW += (delayOven_4.size() > 0) ? 1.8 : 0.0;
    currentPowerKW += amrFleet.utilization() * 3.5; // Active mobile robot power factor

    // 4. Format Scaled JSON Payload including model clock and exact sink count
    String payload = String.format(java.util.Locale.US,
        "{\"timestamp\":%.2f, \"model_hours\":%.4f, \"sink_count\":%d, \"q_accumulation\":%d, \"q_staging\":%d, \"q_downstream\":%d, \"q_inspection\":%d, \"q_packaging\":%d, \"q_palletizer\":%d, \"power_kw\":%.2f}",
        time(), modelHours, totalSinkCount, qAccumulation, qStaging, qDownstream, qInspection, qPackaging, qPalletizer, currentPowerKW
    );

    // 5. Publish to Mosquitto Broker
    try {
        org.eclipse.paho.client.mqttv3.MqttMessage message = new org.eclipse.paho.client.mqttv3.MqttMessage(payload.getBytes("utf-8"));
        message.setQos(1);
        mqttClient.publish("factory/telemetry/scaled_state", message);
        
        traceln("[MQTT TX] " + payload);
    } catch (Exception e) {
        traceln("[MQTT PUB ERROR] " + e.getMessage());
    }
}]]></Action>
				</Event>
				<Event>
					<Id>1792690264287</Id>
					<Name><![CDATA[mqttProcessorEvent]]></Name>
					<X>420</X><Y>890</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1792690264285</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1792742400000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[0.1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[if (pendingSpeedBoost) {
    delayOven1 = 2.0;
    delayOven2 = 2.0;
    delayOven3 = 2.0;
    delayOven4 = 2.0;
    isGated_ClusterA = true;
    isGated_ClusterB = true;
    pendingSpeedBoost = false;
    sourceCluster_A.set_rate(0.0);
    sourceCluster_B.set_rate(0.0);
    traceln("[ACTUATION APPLIED] Speed boost & gating active.");
}

if (pendingResetNominal) {
    delayOven1 = nominalDelayOven;
    delayOven2 = nominalDelayOven;
    delayOven3 = nominalDelayOven;
    delayOven4 = nominalDelayOven;
    isGated_ClusterA = false;
    isGated_ClusterB = false;
    pendingResetNominal = false;
    sourceCluster_A.set_rate(0.15);
    sourceCluster_B.set_rate(0.15);
    traceln("[ACTUATION APPLIED] Reset to nominal.");
}

if (pendingGateA) {
    isGated_ClusterA = true;
    pendingGateA = false;
    sourceCluster_A.set_rate(0.0);
    traceln("[ACTUATION APPLIED] Cluster A Gated.");
}

if (pendingUngateA) {
    isGated_ClusterA = false;
    pendingUngateA = false;
    sourceCluster_A.set_rate(0.15);
    traceln("[ACTUATION APPLIED] Cluster A Ungated.");
}

if (pendingGateB) {
    isGated_ClusterB = true;
    pendingGateB = false;
    sourceCluster_B.set_rate(0.0);
    traceln("[ACTUATION APPLIED] Cluster B Gated.");
}

if (pendingUngateB) {
    isGated_ClusterB = false;
    pendingUngateB = false;
    sourceCluster_B.set_rate(0.15);
    traceln("[ACTUATION APPLIED] Cluster B Ungated.");
}]]></Action>
				</Event>
				<Event>

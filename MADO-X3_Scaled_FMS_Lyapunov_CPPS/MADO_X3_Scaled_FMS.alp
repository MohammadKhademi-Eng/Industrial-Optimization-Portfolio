							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[if (!isBrokenOven1) {
    isBrokenOven1 = true;
    holdOven_1.block();         // Blocks transport upstream
    holdOvenQueue_1.block();    // Blocks queue right before oven delay (NEW)

    traceln("🔒 [HOLD BLOCKS 1] CLOSED at t = " + time() + " | Staging Queue Size: " + stagingBufferDelay.size());
    traceln("⚠️ OVEN 1 BREAKDOWN at t = " + time());

    double repairDuration = triangular(30, 40, 50); 
    eventRepairOven1.restart(repairDuration);
}


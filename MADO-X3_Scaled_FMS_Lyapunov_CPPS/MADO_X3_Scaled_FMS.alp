	</Folders>
	<ActiveObjectClasses>
		<!--   =========   Active Object Class   ========  -->
		<ActiveObjectClass>
			<Id>1792486931514</Id>
			<Name><![CDATA[Main]]></Name>
			<StartupCode><![CDATA[try {
    String brokerUrl = "tcp://localhost:1883";
    String clientId = "Anylogic_FMS_Scaled_" + System.currentTimeMillis();
    mqttClient = new org.eclipse.paho.client.mqttv3.MqttClient(brokerUrl, clientId, new org.eclipse.paho.client.mqttv3.persist.MemoryPersistence());
    
    org.eclipse.paho.client.mqttv3.MqttConnectOptions options = new org.eclipse.paho.client.mqttv3.MqttConnectOptions();
    options.setCleanSession(true);
    options.setAutomaticReconnect(true);
    options.setConnectionTimeout(10);
    mqttClient.connect(options);

    // Subscribe to supervisory actuation commands from Python MCP agents
    mqttClient.subscribe("factory/actuation/commands", 1, (topic, message) -> {
        try {
            String payload = new String(message.getPayload(), "utf-8");
            traceln("[MQTT RX ACTUATION] " + payload);
            
            // Set thread-safe pending flags from the background thread
            if (payload.contains("\"speed_boost\":true") || payload.contains("\"speed_boost\": true")) {
                pendingSpeedBoost = true;
            } 
            if (payload.contains("\"reset_nominal\":true") || payload.contains("\"reset_nominal\": true")) {
                pendingResetNominal = true;
            }
            if (payload.contains("\"gate_cluster_A\":true") || payload.contains("\"gate_cluster_A\": true") || payload.contains("\"gate_upstream\":true")) { 
                pendingGateA = true; 
            }
            if (payload.contains("\"gate_cluster_A\":false") || payload.contains("\"gate_cluster_A\": false") || payload.contains("\"gate_upstream\":false")) { 
                pendingUngateA = true; 
            }
            if (payload.contains("\"gate_cluster_B\":true") || payload.contains("\"gate_cluster_B\": true") || payload.contains("\"gate_upstream\":true")) { 
                pendingGateB = true; 
            }
            if (payload.contains("\"gate_cluster_B\":false") || payload.contains("\"gate_cluster_B\": false") || payload.contains("\"gate_upstream\":false")) { 
                pendingUngateB = true; 
            }
        } catch (Exception err) {
            traceln("[ACTUATION ERROR] " + err.getMessage());
        }
    });

    traceln("[MQTT CONNECTED] Subscribed to factory/actuation/commands.");
} catch (Exception e) {
    traceln("[MQTT CONNECTION ERROR] " + e.getMessage());
}]]></StartupCode>

//    holdOven_1.block(); // Stop new parts from entering Oven 1 line
//    traceln("⚠️ OVEN 1 BREAKDOWN at t = " + time());

//    double repairTime = triangular(30, 60, 90);
//    eventRepairOven1.restart(repairTime);
//}
// 1. Suspend the oven so it stops processing current parts
//delayOven_1.suspend();
//traceln("⚠️ OVEN 1 BREAKDOWN at t = " + time());

// 2. Generate the repair time (MTTR: min 300s, mode 600s, max 1200s)
